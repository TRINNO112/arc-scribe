# Arc Scribe Environment Configuration
# Add your Google AI Studio API key below:
GEMINI_API_KEY=your_google_ai_studio_api_key_here

# Primary recommended model for 500 RPD / 250K TPM:
GEMINI_MODEL=gemini-3.5-flash-lite

# Fallback models:
# GEMINI_MODEL=gemini-3.1-flash-lite
# GEMINI_MODEL=gemini-2.0-flash
# GEMINI_MODEL=gemini-3.8-flash

# Server settings (0.0.0.0 allows your phone to connect over Wi-Fi)
HOST=0.0.0.0
PORT=8000
